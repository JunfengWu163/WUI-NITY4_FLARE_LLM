# FLARE API Keys — copy this file to .env and fill in your real keys
# NEVER commit .env to git — add it to .gitignore

# Anthropic Claude API key
# Get yours at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key
# Get yours at: https://platform.openai.com → API keys
OPENAI_API_KEY=sk-your-key-here

# Model selection (change to experiment with different models)
# Claude options: claude-sonnet-5, claude-opus-5, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5
# OpenAI options: gpt-5.5, gpt-5.4 (verify exact string at platform.openai.com/docs/models)
OPENAI_MODEL=gpt-5.5
